{
  "name": "vivic",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "player:build": "swiftc native/play.swift -O -o native/vivic-play",
    "app": "npm run player:build && concurrently -k -n web,app \"vite --host 127.0.0.1 --port 5173\" \"wait-on http://127.0.0.1:5173/controller.html && electron electron/main.mjs\"",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "test": "vitest run",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.186.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.7",
    "electron": "^44.7.0",
    "gsap": "^3.15.0",
    "lottie-react": "^3.1.2",
    "lucide-react": "^1.56.0",
    "motion": "^12.43.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "wait-on": "^9.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "uiohook-napi": "^1.5.5",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  }
}
